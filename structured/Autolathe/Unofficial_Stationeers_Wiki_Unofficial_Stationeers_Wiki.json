        {
          "Op_code": "3",
          "Name": "WaitUntilNextValid",
          "Description": "This is a flag that if there is an ExecuteRecipe in the next address, then it will wait until it can be completed. So if you put this before an ExecuteRecipe, the device will sit there till the order can be completed because it is waiting for ingredients.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-63",
          "Name": "Unused"
        },
        {
          "Op_code": "4",
          "Name": "JumpIfNextValid",
          "Description": "This is another flag that applies to the next address (if it is ExecuteRecipe). If the recipe cannot be completed, then the Fabricator will jump to the specified address.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
