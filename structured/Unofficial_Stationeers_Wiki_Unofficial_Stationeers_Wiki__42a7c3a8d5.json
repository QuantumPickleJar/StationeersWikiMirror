      "rows": [
        {
          "Op_code": "1",
          "Name": "StackPointer",
          "Description": "The current address the stack pointer is pointing to. It cycles through the available addresses (0 through 53) in a single tick, making it look like it is decreasing for external observer.",
          "Valid Address": "63",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-23",
          "Name": "Index"
        },
        {
          "Op_code": "24-63",
          "Name": "Unused"
        },
        {
          "Op_code": "2",
          "Name": "ExecuteRecipe",
          "Description": "This instruction will set the device to the specified prefabhash, and then begin manufacturing it. The final element of the payload is the quantity. So you can ask the device to make 200 ItemSteelSheets and it will do that. The quantity is a byte - so the maximum you can request is 255.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-15",
          "Name": "Quantity"
        },
        {
          "Op_code": "16-47",
          "Name": "Prefab_hash"
        },
        {
          "Op_code": "48-63",
          "Name": "Unused"
        },
        {
          "Op_code": "3",
          "Name": "WaitUntilNextValid",
          "Description": "This is a flag that if there is an ExecuteRecipe in the next address, then it will wait until it can be completed. So if you put this before an ExecuteRecipe, the device will sit there till the order can be completed because it is waiting for ingredients.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-63",
          "Name": "Unused"
        },
        {
          "Op_code": "4",
          "Name": "JumpIfNextValid",
          "Description": "This is another flag that applies to the next address (if it is ExecuteRecipe). If the recipe cannot be completed, then the Fabricator will jump to the specified address.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-23",
          "Name": "Stack_Address"
        },
        {
          "Op_code": "24-63",
          "Name": "Unused"
        },
        {
          "Op_code": "5",
          "Name": "JumpToAddress",
          "Description": "This will jump to a specific address. This will set the stack pointer to the address you specify.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-23",
          "Name": "Stack_Address"
        },
        {
          "Op_code": "24-63",
          "Name": "Unused"
        },
        {
          "Op_code": "6",
          "Name": "DeviceSetLock",
          "Description": "This will set the lock state of the device (true 1, false 0), similar to the \"L\" IC instruction. Useful if you want to lock the device, do something, then unlock it.",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
        {
          "Op_code": "8-15",
          "Name": "Lock_State"
        },
        {
          "Op_code": "16-63",
          "Name": "Unused"
        },
        {
          "Op_code": "7",
          "Name": "EjectReagent",
          "Description": "This allows you to specity the reagent you want to eject. All reagents of that type will be ejected. The stack will not advance until this is complete",
          "Valid Address": "0-53",
          "Bits": "0-7",
          "Bits Description": "Op_code"
        },
