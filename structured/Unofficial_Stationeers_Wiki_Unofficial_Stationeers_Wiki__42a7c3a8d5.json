      ],
      "rows": [
        {
          "Parameter Name": "On",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "The Autolathe is not powered. This is the same as the physical red powerswitch located on the structure."
        },
        {
          "Parameter Name": "1",
          "Data Type": "The Autolathe is powered. This is the same as the physical red powerswitch located on the structure."
        },
        {
          "Parameter Name": "Open",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "Output of the Autolathe is closed. This is the same as the physical lever located on the structure."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Output of the Autolathe is opened. This is the same as the physical lever located on the structure."
        },
        {
          "Parameter Name": "Activate",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "The structure is currently producing nothing."
        },
        {
          "Parameter Name": "1",
          "Data Type": "The structure is currently producing something."
        },
        {
          "Parameter Name": "Lock",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "1 if device is locked, otherwise 0, can be set in most devices and prevents the user from access the values."
        },
        {
          "Parameter Name": "1",
          "Data Type": "1 if device is locked, otherwise 0, can be set in most devices and prevents the user from access the values."
        },
        {
          "Parameter Name": "Power",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "Can be read to return if the device is correctly powered or not, set via the power system, return 1 if powered and O if not."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Can be read to return if the device is correctly powered or not, set via the power system, return 1 if powered and O if not."
        },
        {
          "Parameter Name": "Error",
          "Data Type": "Boolean",
          "Value": "0",
          "Description": "1 if device is in error state, otherwise 0."
        },
        {
          "Parameter Name": "1",
          "Data Type": "1 if device is in error state, otherwise 0."
        },
        {
          "Parameter Name": "RecipeHash",
          "Data Type": "Integer",
          "Value": "",
          "Description": "Current hash of the recipe the device is set to produce."
        },
        {
          "Parameter Name": "Reagents",
          "Data Type": "Integer",
          "Value": "",
          "Description": "Total number of reagents inside the device (e.g. 92g of iron = 92)."
        },
        {
          "Parameter Name": "RequiredPower",
          "Data Type": "Integer",
          "Value": "",
          "Description": "Idle operating power quantity. Does not include extra power demanded during recipe fabrication."
        },
        {
          "Parameter Name": "CompletionRatio",
          "Data Type": "Integer",
          "Value": "",
          "Description": "How complete the current production is for this device, between 0 and 1."
        },
        {
          "Parameter Name": "ExportCount",
          "Data Type": "Integer",
          "Value": "",
          "Description": "How many items exported since last ClearMemory. This count is based on every ouput stack of items (e.g. 1 item and 12g of iron = 2)."
        },
        {
          "Parameter Name": "ImportCount",
          "Data Type": "Integer",
          "Value": "",
          "Description": "How many items imported since last ClearMemory. The count is based on stacks (e.g. 92g of iron in on stack = 1)."
        },
        {
          "Parameter Name": "PrefabHash",
          "Data Type": "Integer",
          "Value": "",
          "Description": "The hash of the structure."
        },
        {
          "Parameter Name": "Referenceld",
          "Data Type": "Integer",
          "Value": "",
          "Description": "Unique Reference Identifier for this object."
        },
        {
          "Parameter Name": "Update 0.2.4677.21598 - Fri 29/12/2023 /Data_Network"
        }
      ]
