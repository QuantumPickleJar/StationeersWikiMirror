        "ValueAutolathe",
        "Description"
      ],
      "rows": [
        {
          "Parameter Name": "On",
          "Data Type": "Boolean",
          "ValueAutolathe": "0",
          "Description": "Turns the device off. Also toggles the switch accordingly."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Turns the device on. Also toggles the switch accordingly."
        },
        {
          "Parameter Name": "Open",
          "Data Type": "Boolean",
          "ValueAutolathe": "0",
          "Description": "Stops purging of stored materials in the structure. Also resets the lever accordingly."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Starts purging of stored materials in the structure. Also pulls the lever accordingly. Without powering the structure it won't purge anything."
        },
        {
          "Parameter Name": "Activate",
          "Data Type": "Boolean",
          "ValueAutolathe": "0",
          "Description": "Writing a 0 to the device stops the construction of the chosen item."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Writing a 1 to the device starts the construction of the chosen item. If there are not enough materials inside the structure it will starts to fabricate the item anyway, but won't actually produce the item and won't consume any stored resources."
        },
        {
          "Parameter Name": "Lock",
          "Data Type": "Boolean",
          "ValueAutolathe": "0",
          "Description": "Allows manual interaction with the structure."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Completely blocks any manual interaction with the structure. This doesn't inculdes interaction by logic."
        },
        {
          "Parameter Name": "ClearMemory",
          "Data Type": "Boolean",
          "ValueAutolathe": "0",
          "Description": "Writing a 0 to a structure doesn't have any impact."
        },
        {
          "Parameter Name": "1",
          "Data Type": "Clears the counter memory. Will set itself back to 0 when actioned."
        },
        {
          "Parameter Name": "RecipeHash",
          "Data Type": "Integer",
          "ValueAutolathe": "",
          "Description": "Sets the machine to the recipe corresponding to the written hash number."
        },
        {
          "Parameter Name": "Update 0.2.4677.21598 - Fri 29/12/2023 /Data_Network"
        }
      ]
    },
    {
      "caption": null,
      "headers": [
        "Parameter Name",
