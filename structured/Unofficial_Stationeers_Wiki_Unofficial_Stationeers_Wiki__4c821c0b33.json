      ],
      "rows": [
        {
          "Parameter Name": "Lock",
          "Data Type": "Boolean",
          "Description": "Locks the Fabricator, when set to 1. Unlocks it when set to 0."
        },
        {
          "Parameter Name": "ClearMemory",
          "Data Type": "Boolean",
          "Description": "Writing on this Parameter will reset the ExportCount and ImportCount values to zero. Will set itself back to 0 when actioned."
        },
        {
          "Parameter Name": "Activate",
          "Data Type": "Boolean",
          "Description": "Activates the Fabricator, when set to 1. Deactivates it, when set to 0."
        },
        {
          "Parameter Name": "Open",
          "Data Type": "Boolean",
          "Description": "Opens the Fabricator, when set to 1. Closes it, when set to 0."
        },
        {
          "Parameter Name": "On",
          "Data Type": "Boolean",
          "Description": "Turns the Fabricator on, when set to 1. Turns it off, when set to 0."
        }
      ]
    },
    {
      "caption": null,
      "headers": [
        "Output Name",
        "Data Type",
        "Description"
      ],
      "rows": [
        {
          "Output Name": "Open",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is open. (0 for no, 1 for yes)"
        },
        {
          "Output Name": "On",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is turned on. (0 for no, 1 for yes)"
        },
        {
          "Output Name": "Lock",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is locked. (0 for no, 1 for yes)"
        },
        {
          "Output Name": "ImportCount",
          "Data Type": "Integer",
          "Description": "How many items imported since last ClearMemory."
        },
        {
          "Output Name": "ExportCount",
          "Data Type": "Integer",
          "Description": "How many items exported since last ClearMemory."
        },
        {
          "Output Name": "Error",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is flashing an error. (0 for no, 1 for yes)"
        },
        {
          "Output Name": "Activate",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is active. (0 for no, 1 for yes)"
        },
        {
          "Output Name": "RequiredPower",
          "Data Type": "Integer",
          "Description": "The amount of power, currently needed by the Fabricator, in Watts."
        },
        {
          "Output Name": "RecipeHash",
          "Data Type": "Integer",
          "Description": "Current hash of the recipe the device is set to produce."
        },
        {
          "Output Name": "Reagents",
          "Data Type": "Float",
          "Description": "Returns the amount of reagent contents in the Fabricator in grams."
        },
        {
          "Output Name": "PrefabHash",
          "Data Type": "Integer",
          "Description": "The hash of the structure."
        },
        {
          "Output Name": "Power",
          "Data Type": "Boolean",
          "Description": "Returns whether the Fabricator is turned on and receives power. (0 for no, 1 for yes)"
        }
      ]
    }
